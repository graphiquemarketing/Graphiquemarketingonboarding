# Portal de clientes Graphique · copia a .env.local (desarrollo) o configúralas en el hosting.
# STAGING: usa un proyecto de Supabase distinto al de producción.
PORTAL_ENV=staging
NEXT_PUBLIC_SITE_URL=https://staging-clientes.graphiquemarketing.com.mx
NEXT_PUBLIC_SUPABASE_URL=https://<proyecto-staging>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreta: nunca en el navegador ni en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=
# Cadena aleatoria larga para anonimizar IPs en el límite de solicitudes (openssl rand -hex 32).
IP_HASH_SALT=
# Correo transaccional (Resend). Vacío = correos simulados en el log.
RESEND_API_KEY=
EMAIL_FROM="Graphique Marketing <portal@graphiquemarketing.com.mx>"
# Bandeja interna para avisos de nuevas solicitudes, briefs y aclaraciones.
EMAIL_INTERNAL=contacto@graphiquemarketing.com.mx
# Opcional. Vacío = sin GTM en el portal.
NEXT_PUBLIC_GTM_ID=

# Longitud del código por correo; igual a Supabase › Auth › Email › «Email OTP Length». Por omisión 6.
NEXT_PUBLIC_EMAIL_OTP_LENGTH=6
